{
  "name": "finn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . && node tools/ci/verificar-dependencias.mjs && node tools/ci/lecturas-interactivas.mjs && node tools/lint/bloqueos-sesion.mjs && node tools/lint/l21.mjs && stylelint \"apps/web/**/*.css\" --allow-empty-input && depcruise --config .dependency-cruiser.cjs apps packages",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "formato": "prettier --write .",
    "formato:comprobar": "prettier --check .",
    "versiones": "node tools/pruebas/versiones.mjs",
    "versiones:negativo": "node tools/lint/controles/versiones/negativo.mjs",
    "pruebas:listar": "node tools/pruebas/listar.ts",
    "pruebas:matriz": "node tools/pruebas/matriz.ts verificar",
    "pruebas:ft": "node tools/pruebas/ft.ts",
    "pruebas:afectadas": "node tools/pruebas/afectadas.ts",
    "pruebas:informe": "node tools/pruebas/matriz.ts informe",
    "pruebas:resumen": "node tools/pruebas/resumen.ts",
    "plan:verificar": "node tools/plan/estado.ts verificar",
    "plan:siguiente": "node tools/plan/estado.ts siguiente",
    "plan:anexos": "node tools/plan/anexos.ts --plan docs/08-tareas.md --anexos docs/anexos --negativo",
    "plan:encargo": "node tools/plan/encargo.ts --plan docs/08-tareas.md --docs docs --tarea",
    "plan:permisos": "node --test tools/plan/permisos.test.ts",
    "plan:token": "node tools/plan/token.ts",
    "pr:mergear": "node tools/plan/mergear.ts",
    "test": "node tools/pruebas/vitest.mjs --project unidad --project escenarios-motor --project contratos --project componentes",
    "test:unidad": "node tools/pruebas/vitest.mjs --project unidad",
    "test:escenarios": "vitest run --project escenarios-motor --coverage.enabled=false --passWithNoTests",
    "test:contratos": "vitest run --project contratos --coverage.enabled=false --passWithNoTests",
    "test:integracion": "vitest run --project integracion --coverage.enabled=false --passWithNoTests",
    "test:componentes": "vitest run --project componentes --coverage.enabled=false --passWithNoTests",
    "test:e2e": "node tools/pruebas/e2e.mjs",
    "bench": "vitest bench --run --project unidad --passWithNoTests",
    "ci:rapido": "node tools/ci/afecta.mjs rapido",
    "ci:integracion": "node tools/ci/publicar-resultados.mjs integracion -- pnpm test:integracion --reporter=default --reporter=json --outputFile.json=test-results/informes/integracion.json",
    "ci:e2e": "node tools/ci/afecta.mjs e2e",
    "ci:nocturno": "node tools/ci/afecta.mjs nocturno",
    "ci:cierre": "pnpm pruebas:listar && node tools/pruebas/matriz.ts verificar --resultados test-results/informes",
    "ci:local": "node tools/ci/afecta.mjs local",
    "ci:politica-patrones": "node tools/ci/politica-patrones.ts",
    "test:respaldo": "vitest run --project respaldo --coverage.enabled=false --passWithNoTests",
    "docs:comprobar": "node tools/docs/comprobar.mjs"
  },
  "prettier": "@finn/config/prettier",
  "devDependencies": {
    "@finn/config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "age-encryption": "0.3.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "js-yaml": "4.3.2",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
